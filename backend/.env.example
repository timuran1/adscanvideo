# Server-only configuration. Never copy real values into the frontend or Git.
OPENROUTER_API_KEY=
ADSCAN_QUOTA_SECRET=
ADSCAN_ADMIN_TOKEN=
# Short videos transcribe automatically even when long-video Whisper is off.
ADSCAN_ENABLE_WHISPER=0
ADSCAN_WHISPER_AUTO_MAX_SECONDS=120
ADSCAN_WHISPER_MODEL=base
ADSCAN_WHISPER_TIMEOUT=150
ADSCAN_JOB_TIMEOUT=480
ADSCAN_STUCK_SECONDS=600
# Optional until Stripe is ready. Use test keys first.
STRIPE_BILLING_ENABLED=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One-time USD $3.99 Price. Set the matching sandbox/live Price ID with its key.
STRIPE_PRICE_VIDEO=
# Monthly USD $39.99 recurring Price (20 additional analyses per paid billing period).
# Leave disabled until the recurring Price, signed invoice webhooks, customer portal,
# browser access-key recovery, and a test renewal have been verified end to end.
STRIPE_SUBSCRIPTION_ENABLED=0
STRIPE_PRICE_MONTHLY=
# Stripe's no-code customer portal login URL for this AdScanVideo account only.
STRIPE_PORTAL_LOGIN_URL=

# Optional transactional report links. Enable only after a verified Resend test.
ADSCAN_REPORT_EMAIL_ENABLED=0
RESEND_API_KEY=
RESEND_FROM=AdScanVideo <reports@mail.adscanvideo.com>
RESEND_REPLY_TO=

# AI studio (swap in video, recreate an ad) through the Sume API. Each generation
# spends the Sume workspace balance, so keep SUME_ENABLED=0 until pricing is approved.
SUME_ENABLED=0
SUME_API_KEY=
# Model ids and prices: GET https://api.sume.com/v1/video-router/models with the key.
# Recreate: MAGI-2, 1080p only, $0.08 per second (26 Nov 2026). seedance-2.5-flash
# also works here with SUME_VIDEO_RESOLUTION=480p or 720p.
SUME_VIDEO_MODEL=magi-2
SUME_VIDEO_RESOLUTION=1080p
SUME_IMAGE_MODEL=nano-banana-2.1
# Swap: Sume Remix (Genjutsu). Clips up to 15 s use Light ($0.10 per second),
# longer clips, up to 30 s, use full Remix ($0.318 per second at 480p).
SUME_SWAP_LIGHT_MODEL=higgsfield-genjutsu-light-object-swap
SUME_SWAP_MODEL=higgsfield-genjutsu-object-swap
SUME_MOTION_LIGHT_MODEL=higgsfield-genjutsu-light
SUME_MOTION_MODEL=higgsfield-genjutsu
SUME_SWAP_RESOLUTION=480p
# Billed seconds per paid credit. These keep model cost at or under half of the
# lowest net credit price, about $2.85 in the 5 pack after card fees.
SUME_SECONDS_PER_CREDIT=15
SUME_SWAP_LIGHT_SECONDS_PER_CREDIT=10
SUME_SWAP_SECONDS_PER_CREDIT=4
SUME_VIDEOS_PER_DAY=20
SUME_IMAGES_PER_DAY=10
SUME_UPLOADS_PER_DAY=40
