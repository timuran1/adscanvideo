# Server-only configuration. Never copy real values into the frontend or Git.
OPENROUTER_API_KEY=
ADSCAN_QUOTA_SECRET=
ADSCAN_ADMIN_TOKEN=
# Short videos transcribe automatically even when long-video Whisper is off.
ADSCAN_ENABLE_WHISPER=0
ADSCAN_WHISPER_AUTO_MAX_SECONDS=120
ADSCAN_WHISPER_MODEL=base
ADSCAN_WHISPER_TIMEOUT=150
ADSCAN_JOB_TIMEOUT=480
ADSCAN_STUCK_SECONDS=600
# Optional until Stripe is ready. Use test keys first.
STRIPE_BILLING_ENABLED=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One-time USD $3.99 Price. Set the matching sandbox/live Price ID with its key.
STRIPE_PRICE_VIDEO=
# Monthly USD $39.99 recurring Price (20 additional analyses per paid billing period).
# Leave disabled until the recurring Price, signed invoice webhooks, customer portal,
# browser access-key recovery, and a test renewal have been verified end to end.
STRIPE_SUBSCRIPTION_ENABLED=0
STRIPE_PRICE_MONTHLY=
# Stripe's no-code customer portal login URL for this AdScanVideo account only.
STRIPE_PORTAL_LOGIN_URL=
