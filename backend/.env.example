# Server-only configuration. Never copy real values into the frontend or Git.
OPENROUTER_API_KEY=
ADSCAN_QUOTA_SECRET=
ADSCAN_ADMIN_TOKEN=
# Short videos transcribe automatically even when long-video Whisper is off.
ADSCAN_ENABLE_WHISPER=0
ADSCAN_WHISPER_AUTO_MAX_SECONDS=120
ADSCAN_WHISPER_MODEL=base
ADSCAN_WHISPER_TIMEOUT=150
ADSCAN_JOB_TIMEOUT=480
ADSCAN_STUCK_SECONDS=600
# Optional until Stripe is ready. Use test keys first.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One-time USD $0.50 Price. Other prices are rejected by fulfillment.
STRIPE_PRICE_VIDEO=
